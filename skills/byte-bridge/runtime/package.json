{
  "name": "@byte-skills/bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Byte Skills cross-agent chat coordination runtime",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "bin": {
    "session-bridge": "dist/src/cli/main.js",
    "byte-bridge": "dist/src/cli/main.js"
  },
  "files": [
    "dist/src",
    "skills",
    "plugins",
    "README.md",
    "README.zh-CN.md",
    "assets",
    ".agents/plugins/marketplace.json",
    "docs/support.md",
    "docs/support.en.md",
    "docs/cli.md",
    "docs/cli.zh-CN.md",
    "docs/zcode.md",
    "docs/zcode.zh-CN.md",
    "docs/acp.md",
    "docs/acp.zh-CN.md",
    "docs/byte.md",
    "docs/byte.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src tests scripts --no-error-on-unmatched-pattern",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node scripts/check-command-contracts.mjs && node --test dist/tests/unit/*.test.js dist/tests/integration/*.test.js",
    "test:unit": "npm run build && node --test dist/tests/unit/*.test.js",
    "test:integration": "npm run build && node --test dist/tests/integration/*.test.js",
    "test:live": "npm run build && node dist/tests/live/run.js",
    "pack:plugins": "node scripts/pack-plugins.mjs",
    "prepack": "npm run build && node scripts/check-command-contracts.mjs && npm run pack:plugins",
    "generate:contracts": "npm run build && node scripts/check-command-contracts.mjs --write && npm run pack:plugins",
    "check:contracts": "npm run build && node scripts/check-command-contracts.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-api-remote-access": "0.2.1-rc.2",
    "@deepseek-ai/dsh-api-session-controller": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@types/node": "24.9.1",
    "eslint": "9.39.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2"
  },
  "bundledDependencies": [
    "@modelcontextprotocol/sdk",
    "zod"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/elan6666/byte-skills.git",
    "directory": "packages/byte-bridge"
  }
}
